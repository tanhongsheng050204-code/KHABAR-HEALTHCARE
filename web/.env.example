# The browser calls this public API URL. Use localhost for the existing local demo.
NEXT_PUBLIC_KHABAR_API_URL=http://localhost:8080

# Optional: enables the email-code sign-in screen. Both values are public client configuration;
# never put a Supabase service_role key in this file or in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
