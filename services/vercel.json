{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "services": {
    "api": {
      "root": "api",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "agents": {
      "root": "agents",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/agents/(.*)",
      "destination": {
        "service": "agents"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "api"
      }
    }
  ]
}
