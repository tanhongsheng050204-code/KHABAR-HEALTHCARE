# ==============================================================================
# KHABAR ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in the values. NEVER COMMIT .env TO GIT!
# ==============================================================================

# --- Internal Microservice Security ---
# Shared secret for communication between Spring Boot (api) and FastAPI (agents)
INTERNAL_SERVICE_KEY=change-this-to-a-secure-random-token-in-production

# --- Sensitive Field Encryption (Spring Boot only) ---
# 256-bit AES encryption key in hex format (64 hex characters)
# Generate with: openssl rand -hex 32
# The API refuses to start with a missing or placeholder key.
FIELD_ENCRYPTION_KEY=

# --- Supabase / PostgreSQL ---
# Set ONE of these so the API can verify sign-ins:
# new projects (asymmetric keys):
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# legacy projects (shared HS256 secret, 32+ characters):
SUPABASE_JWT_SECRET=
DATABASE_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres?sslmode=require
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password

# --- Neo4j (AuraDB or Local) ---
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# --- AI & Transcription Keys ---
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=your-groq-api-key

# --- Messaging (WhatsApp Cloud API) ---
WHATSAPP_TOKEN=your-meta-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
# App secret from Meta's app dashboard; used to check webhook signatures
WHATSAPP_APP_SECRET=your-meta-app-secret
# Name of your approved check-in template (one version per language: ms, en, zh_CN, ta)
WHATSAPP_CHECKIN_TEMPLATE=khabar_checkin

